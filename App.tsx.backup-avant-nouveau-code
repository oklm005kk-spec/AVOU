const languages:[Lang,string][] = [["fr","Français 🇫🇷"],["en","English 🇬🇧"],["it","Italiano 🇮🇹"],["ar","العربية 🇸🇦"],["zh","中文 🇨🇳"],["hi","हिन्दी 🇮🇳"],["bn","বাংলা 🇧🇩"],["pt","Português 🇵🇹"],["ru","Русский 🇷🇺"],["ur","اردو 🇵🇰"]];

function makeGame(code:string, host:Player):Game {
  return {code,hostId:host.id,players:[host],requests:[],mode:"target",identity:"reveal",order:"order",phase:"lobby",round:1,currentPlayerId:host.id,targetPlayerId:null,proposals:[],submitted:[],selectedId:null,revealed:false,demasking:false,votes:{},result:null,version:1};
}
function nextId(g:Game):string {
  if (g.order === "disorder") {
    const others=g.players.filter(p=>p.id!==g.currentPlayerId);
    return (others[Math.floor(Math.random()*others.length)] ?? g.players[0])?.id ?? "";
  }
  const i=g.players.findIndex(p=>p.id===g.currentPlayerId);
  return g.players[(i+1)%g.players.length]?.id ?? g.players[0]?.id ?? "";
}
function sameState(a:Game,b:Game){return JSON.stringify(a)===JSON.stringify(b)}

export default function App(){
  const [lang,setLang]=useState<Lang>("fr");
  const t=TEXT[lang];
  const [screen,setScreen]=useState<"home"|"create"|"join"|"game">("home");
  const [name,setName]=useState("");
  const [avatar,setAvatar]=useState(avatars[0]);
  const [code,setCode]=useState("");
  const [game,setGame]=useState<Game|null>(null);
  const gameRef=useRef<Game|null>(null); gameRef.current=game;
  const channel=useRef<RealtimeChannel|null>(null);
  const idRef=useRef(uid());
  const requestTimers=useRef<ReturnType<typeof setInterval>|null>(null);
  const [error,setError]=useState("");
  const [rules,setRules]=useState(false);
  const [settings,setSettings]=useState(false);
  const [action,setAction]=useState(""); const [truth,setTruth]=useState("");
  const [target,setTarget]=useState(""); const [targetType,setTargetType]=useState<"action"|"truth">("truth"); const [targetText,setTargetText]=useState("");
  const [pendingRequest,setPendingRequest]=useState(false); const [requestId,setRequestId]=useState("");

  useEffect(()=>{(async()=>{try{const n=await AsyncStorage.getItem(NICK_KEY);const l=await AsyncStorage.getItem(LANG_KEY);if(n)setName(n);if(l && languages.some(x=>x[0]===l))setLang(l as Lang);}catch{}})()},[]);
  useEffect(()=>{AsyncStorage.setItem(NICK_KEY,name.trim()).catch(()=>{})},[name]);
  useEffect(()=>{AsyncStorage.setItem(LANG_KEY,lang).catch(()=>{})},[lang]);

  const closeChannel=useCallback(()=>{if(channel.current){supabase?.removeChannel(channel.current);channel.current=null}},[]);
  useEffect(()=>()=>{closeChannel();if(requestTimers.current)clearInterval(requestTimers.current)},[closeChannel]);

  const applyState=useCallback((incoming:Game)=>{
    setGame(prev=>sameState(prev??incoming,incoming)?prev:incoming);
    gameRef.current=incoming;
    setScreen("game");
  },[]);

  const send=useCallback(async(w:Wire)=>{
    if(!channel.current) return;
    try{await channel.current.send({type:"broadcast",event:"avou",payload:w})}catch(e){console.log("AVOU broadcast",e)}
  },[]);

  const publishState=useCallback(async(g:Game)=>{
    const out={...g,version:g.version+1};
    gameRef.current=out; setGame(out); await send({kind:"STATE",state:out});
  },[send]);

  const connect=useCallback(async(gameCode:string,onReady?:()=>void)=>{
    if(!supabase){setError("Clé Supabase manquante. Ajoute EXPO_PUBLIC_SUPABASE_ANON_KEY dans .env puis relance Expo.");return null}
    closeChannel();
    const ch=supabase.channel(`avou:${gameCode}`,{config:{broadcast:{self:false}}});
    ch.on("broadcast",{event:"avou"},({payload}:{payload:Wire})=>{
      const w=payload;
      if(w.kind==="STATE"){
        const local=gameRef.current;
        if(!local || w.state.version>=local.version) applyState(w.state);
      } else if(w.kind==="JOIN_REQUEST"){
        const local=gameRef.current;
        if(local && local.hostId===idRef.current && !local.players.some(p=>p.id===w.player.id)){
          const next={...local,requests:local.requests.some(p=>p.id===w.player.id)?local.requests:[...local.requests,w.player],version:local.version+1};
          gameRef.current=next;setGame(next);send({kind:"STATE",state:next});
        }
      } else if(w.kind==="JOIN_RESULT" && w.player.id===idRef.current && w.requestId===requestId){
        if(requestTimers.current)clearInterval(requestTimers.current);
        setPendingRequest(false);
        if(w.accepted){
          const local=gameRef.current;
          if(local) applyState({...local,players:local.players.some(p=>p.id===w.player.id)?local.players:[...local.players,w.player]});
          send({kind:"PING",requestId:uid()});
        } else Alert.alert("AVOU", "Le Maître de jeu a refusé l'entrée.");
      }
    });
    ch.subscribe(s=>{if(s==="SUBSCRIBED")onReady?.()});
    channel.current=ch; return ch;
  },[applyState,closeChannel,requestId,send]);

  const createGame=async()=>{
    setError(""); const n=name.trim(); if(!n){setError("Entre ton pseudo.");return}
    if(!supabase){setError("Clé Supabase manquante. Vérifie EXPO_PUBLIC_SUPABASE_ANON_KEY.");return}
    const me={id:idRef.current,name:n,avatar}; const g=makeGame(code4(),me);
    await connect(g.code); gameRef.current=g;setGame(g);setScreen("game"); await send({kind:"STATE",state:g});
  };

  const joinGame=async()=>{
    setError(""); const n=name.trim(); const c=code.trim().toUpperCase(); if(!n){setError("Entre ton pseudo.");return} if(c.length!==4){setError("Le code doit contenir 4 caractères.");return}
    if(!supabase){setError("Clé Supabase manquante. Vérifie EXPO_PUBLIC_SUPABASE_ANON_KEY.");return}
    const me={id:idRef.current,name:n,avatar}; const rid=uid(); setRequestId(rid); setPendingRequest(true);
    const ch=await connect(c); if(!ch){setPendingRequest(false);return}
    const ask=()=>send({kind:"JOIN_REQUEST",player:me,requestId:rid});
    ask(); if(requestTimers.current)clearInterval(requestTimers.current); requestTimers.current=setInterval(ask,1800);
    setCode(c);setScreen("game");
    setTimeout(()=>{if(pendingRequest){}},9000);
  };

  const hostAction=async(mutator:(g:Game)=>Game)=>{const g=gameRef.current;if(!g||g.hostId!==idRef.current)return;await publishState(mutator({...g}));};

  const approve=async(p:Player,ok:boolean)=>{const g=gameRef.current;if(!g||g.hostId!==idRef.current)return;const next=ok?{...g,players:g.players.some(x=>x.id===p.id)?g.players:[...g.players,p],requests:g.requests.filter(x=>x.id!==p.id),version:g.version+1}:{...g,requests:g.requests.filter(x=>x.id!==p.id),version:g.version+1};gameRef.current=next;setGame(next);await send({kind:"JOIN_RESULT",accepted:ok,player:p,requestId:uid()});await send({kind:"STATE",state:next})};

  const start=async()=>{const g=gameRef.current;if(!g||g.hostId!==idRef.current)return;if(g.players.length<(g.mode==="intense"?3:2)){setError(g.mode==="intense"?t.min3:t.min2);return} await publishState({...g,phase:"preparation",currentPlayerId:g.players[0].id,submitted:[],proposals:[],selectedId:null,targetPlayerId:null,result:null});};

  const submitIntense=async()=>{const g=gameRef.current;if(!g||g.phase!=="preparation"||g.mode!=="intense"||g.currentPlayerId===idRef.current||!action.trim()||!truth.trim()||g.submitted.includes(idRef.current))return;const ps=[...g.proposals,{id:uid(),type:"action" as const,text:action.trim(),authorId:idRef.current},{id:uid(),type:"truth" as const,text:truth.trim(),authorId:idRef.current}];const sub=[...g.submitted,idRef.current];setAction("");setTruth("");await publishState({...g,proposals:ps,submitted:sub,phase:sub.length===g.players.filter(p=>p.id!==g.currentPlayerId).length?"play":"preparation"});};

  const submitTarget=async()=>{const g=gameRef.current;if(!g||g.phase!=="preparation"||g.mode!=="target"||g.currentPlayerId!==idRef.current||!target||!targetText.trim())return;const p={id:uid(),type:targetType,text:targetText.trim(),authorId:idRef.current};await publishState({...g,proposals:[p],submitted:[idRef.current],targetPlayerId:target,phase:"play"});setTargetText("")};

  const select=async(p:Proposal)=>{const g=gameRef.current;if(!g||g.phase!=="play")return;const targetId=g.mode==="target"?g.targetPlayerId:g.currentPlayerId;if(targetId!==idRef.current)return;await publishState({...g,selectedId:p.id,phase:"reveal",revealed:false})};
  const reveal=async()=>{const g=gameRef.current;if(!g||g.phase!=="reveal"||g.selectedId==null)return;const p=g.proposals.find(x=>x.id===g.selectedId);if(!p)return;if(g.mode==="intense"&&g.demasking){await publishState({...g,revealed:true,phase:"vote"})}else await publishState({...g,revealed:true})};
  const vote=async(author:string)=>{const g=gameRef.current;if(!g||g.phase!=="vote"||g.votes[idRef.current])return;const votes={...g.votes,[idRef.current]:author};const eligible=g.proposals.map(p=>p.authorId);const done=g.players.every(p=>votes[p.id]);if(!done){await publishState({...g,votes});return}const counts=eligible.reduce((m,id)=>(m[id]=(m[id]||0)+Object.values(votes).filter(v=>v===id).length,m),{} as Record<string,number>);const max=Math.max(0,...Object.values(counts));const winners=Object.keys(counts).filter(id=>counts[id]===max);await publishState({...g,votes,result:winners.length===1?winners[0]:null,phase:"result"})};
  const next=async()=>{const g=gameRef.current;if(!g||g.currentPlayerId!==idRef.current)return;const currentIndex=g.players.findIndex(p=>p.id===g.currentPlayerId);const nextPlayer=nextId(g);await publishState({...g,round:g.round+1,currentPlayerId:nextPlayer,phase:"preparation",proposals:[],submitted:[],selectedId:null,revealed:false,targetPlayerId:null,votes:{},result:null});};

  const leave=async()=>{const g=gameRef.current;if(!g)return; if(g.phase!=="lobby"&&g.phase!=="end"&&g.currentPlayerId===idRef.current){Alert.alert("AVOU","Tu ne peux pas quitter pendant ton tour.");return}const remaining=g.players.filter(p=>p.id!==idRef.current);closeChannel();if(remaining.length===0){setGame(null);setScreen("home");return}const host=g.hostId===idRef.current?remaining[0].id:g.hostId;const nextG={...g,players:remaining,hostId:host,phase:remaining.length<2?"end":g.mode==="intense"&&remaining.length<3?"preparation":g.phase,mode:g.mode==="intense"&&remaining.length<3?"target":g.mode,currentPlayerId:remaining.some(p=>p.id===g.currentPlayerId)?g.currentPlayerId:remaining[0].id,version:g.version+1};gameRef.current=nextG;await connect(nextG.code);await send({kind:"STATE",state:nextG});setGame(null);setScreen("home")};

  const share=async()=>{const g=gameRef.current;if(g)await Share.share({message:`AVOU — rejoins ma partie avec le code ${g.code}`})};

  const me=game?.players.find(p=>p.id===idRef.current);
  const isHost=!!game&&game.hostId===idRef.current;
  const current=game?.players.find(p=>p.id===game.currentPlayerId);
  const targetPlayer=game?.players.find(p=>p.id===game.targetPlayerId);
  const selected=game?.proposals.find(p=>p.id===game.selectedId);
  const isTarget=game?.mode==="target"&&game.targetPlayerId===idRef.current;
  const isCurrent=game?.currentPlayerId===idRef.current;

  const rulesText=`AVOU — RÈGLES DU JEU\n\n🎯 MODE CIBLE\nÀ partir de 2 joueurs. Le joueur actif choisit une cible et écrit une Action OU une Vérité. La cible voit uniquement le type, choisit, puis le contenu est révélé.\n\n🔥 MODE INTENSE\nÀ partir de 3 joueurs. Tous les joueurs sauf la cible écrivent une Action et une Vérité. La cible choisit une proposition sans voir son contenu. Les propositions sont supprimées après le tour.\n\n👁️ IDENTITÉS\nEn Mode Cible, elles sont révélées. En Mode Intense, le Maître de jeu choisit révélées ou cachées.\n\n🎲 ORDRE / DÉSORDRE\nOrdre = séquence fixe. Désordre = l'application choisit le prochain joueur aléatoirement.\n\n🎭 DÉMASQUAGE\nEn Intense, si activé par le Maître de jeu, tous les joueurs votent après la révélation pour deviner l'auteur. Le résultat est affiché avant le tour suivant.\n\n👑 MAÎTRE DE JEU\nLe créateur est Maître de jeu. Lui seul modifie les réglages. S'il quitte, le rôle passe au premier joueur restant.\n\n🚪 SORTIE\nUn joueur peut quitter hors de son tour. Si Intense passe sous 3 joueurs, la partie repasse automatiquement en Cible.`;

  if(screen==="home") return <SafeAreaView style={s.safe}><StatusBar barStyle="dark-content"/><ScrollView contentContainerStyle={s.container}>
    <Text style={s.logo}>AVOU</Text><Text style={s.subtitle}>GOOD VIBE • ACTION OU VÉRITÉ</Text>
    <TextInput value={name} onChangeText={setName} placeholder={t.name} style={s.input}/>
    <View style={s.avatarRow}>{avatars.map(a=><TouchableOpacity key={a} onPress={()=>setAvatar(a)} style={[s.avatar,avatar===a&&s.avatarOn]}><Text style={{fontSize:28}}>{a}</Text></TouchableOpacity>)}</View>
    <TouchableOpacity style={s.btnPink} onPress={()=>setScreen("create")}><Text style={s.btnText}>{t.create}</Text></TouchableOpacity>
    <TouchableOpacity style={s.btnPurple} onPress={()=>setScreen("join")}><Text style={s.btnText}>{t.join}</Text></TouchableOpacity>
    <TouchableOpacity style={s.btnYellow} onPress={()=>{}}><Text style={s.btnDark}>{t.rules}</Text></TouchableOpacity>
    <Text style={s.section}>{t.language}</Text>{languages.map(([c,label])=><TouchableOpacity key={c} onPress={()=>setLang(c)} style={[s.lang,c===lang&&s.langOn]}><Text style={s.langText}>{label}</Text></TouchableOpacity>)}
    {error?<Text style={s.error}>{error}</Text>:null}
  </ScrollView></SafeAreaView>;

  if(screen==="create") return <SafeAreaView style={s.safe}><View style={s.container}><Text style={s.h1}>{t.create}</Text><Text style={s.muted}>Pseudo : {name||"—"}</Text><TouchableOpacity style={s.btnPink} onPress={createGame}><Text style={s.btnText}>{t.createNow}</Text></TouchableOpacity><TouchableOpacity onPress={()=>setScreen("home")}><Text style={s.back}>{t.back}</Text></TouchableOpacity>{error?<Text style={s.error}>{error}</Text>:null}</View></SafeAreaView>;
  if(screen==="join"&&!pendingRequest) return <SafeAreaView style={s.safe}><View style={s.container}><Text style={s.h1}>{t.join}</Text><TextInput value={code} onChangeText={v=>setCode(v.toUpperCase())} maxLength={4} autoCapitalize="characters" placeholder={t.code} style={s.codeInput}/><TouchableOpacity style={s.btnPurple} onPress={joinGame}><Text style={s.btnText}>{t.joinNow}</Text></TouchableOpacity><TouchableOpacity onPress={()=>setScreen("home")}><Text style={s.back}>{t.back}</Text></TouchableOpacity>{error?<Text style={s.error}>{error}</Text>:null}</View></SafeAreaView>;

  if(!game) return <SafeAreaView style={s.safe}><View style={s.container}><Text style={s.h1}>{t.waiting}</Text><Text style={s.codeBig}>{code}</Text><Text style={s.muted}>{pendingRequest?"Demande envoyée au Maître de jeu. Cette fenêtre reste ouverte pendant la connexion.":t.badCode}</Text><TouchableOpacity onPress={()=>{setPendingRequest(false);setScreen("home");closeChannel()}}><Text style={s.back}>{t.back}</Text></TouchableOpacity></View></SafeAreaView>;

  return <SafeAreaView style={s.safe}><ScrollView contentContainerStyle={s.container}>
    <View style={s.top}><View><Text style={s.logoSmall}>AVOU</Text><Text style={s.codeLabel}>{game.code}</Text></View><View style={s.topBtns}><TouchableOpacity onPress={share}><Text style={s.icon}>↗</Text></TouchableOpacity><TouchableOpacity onPress={()=>setSettings(true)}><Text style={s.icon}>⚙️</Text></TouchableOpacity></View></View>
    <Text style={s.h2}>{current?.name} • Tour {game.round}</Text>
    <View style={s.players}>{game.players.map(p=><View key={p.id} style={s.player}><Text style={{fontSize:24}}>{p.avatar}</Text><Text style={s.playerName}>{p.name}{p.id===game.hostId?" 👑":""}</Text></View>)}</View>
    {isHost&&game.requests.length>0?<View style={s.panel}><Text style={s.h2}>{t.requests}</Text>{game.requests.map(p=><View key={p.id} style={s.request}><Text>{p.avatar} {p.name}</Text><View style={s.row}><TouchableOpacity style={s.smallGreen} onPress={()=>approve(p,true)}><Text>{t.accept}</Text></TouchableOpacity><TouchableOpacity style={s.smallRed} onPress={()=>approve(p,false)}><Text>{t.reject}</Text></TouchableOpacity></View></View>)}</View>:null}
    {game.phase==="lobby"?<View style={s.panel}><Text style={s.h1}>{isHost?t.host:t.waiting}</Text><Text style={s.muted}>{t.players}: {game.players.length}</Text>{isHost&&<><TouchableOpacity style={s.mode} onPress={()=>hostAction(g=>({...g,mode:"target",identity:"reveal",demasking:false}))}><Text>{t.target}</Text></TouchableOpacity><TouchableOpacity style={s.mode} disabled={game.players.length<3} onPress={()=>hostAction(g=>({...g,mode:"intense"}))}><Text>{t.intense}</Text></TouchableOpacity><TouchableOpacity style={s.btnPink} onPress={start}><Text style={s.btnText}>{t.start}</Text></TouchableOpacity></>}</View>:null}
