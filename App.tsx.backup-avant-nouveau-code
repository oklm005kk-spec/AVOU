    {game.phase==="preparation"&&game.mode==="intense"&&!isCurrent?<View style={s.panel}><Text style={s.h2}>{t.writeAction}</Text><TextInput value={action} onChangeText={setAction} style={s.input}/><Text style={s.h2}>{t.writeTruth}</Text><TextInput value={truth} onChangeText={setTruth} style={s.input}/><TouchableOpacity style={s.btnPink} onPress={submitIntense}><Text style={s.btnText}>{t.send}</Text></TouchableOpacity></View>:null}
    {game.phase==="preparation"&&((game.mode==="intense"&&isCurrent)||game.mode==="target"&&!isCurrent)?<Text style={s.muted}>{t.waiting}</Text>:null}
    {game.phase==="play"&&isTarget?<View style={s.panel}><Text style={s.h1}>{t.choose}</Text>{game.proposals.map((p,i)=><TouchableOpacity key={p.id} onPress={()=>select(p)} style={s.card}><Text style={s.cardNum}>{i+1}</Text><Text style={s.cardType}>{p.type==="action"?"🔥 ACTION":"💬 VÉRITÉ"}</Text><Text style={s.muted}>CONTENU CACHÉ</Text></TouchableOpacity>)}</View>:null}
    {game.phase==="reveal"&&selected?<View style={s.panel}><Text style={s.h1}>{selected.type==="action"?"🔥 ACTION":"💬 VÉRITÉ"}</Text>{game.revealed?<><Text style={s.revealText}>{selected.text}</Text>{game.mode==="intense"&&game.demasking&&isTarget?null:<TouchableOpacity style={s.btnPurple} onPress={next}><Text style={s.btnText}>{t.next}</Text></TouchableOpacity>}</>:isTarget?<TouchableOpacity style={s.btnPink} onPress={reveal}><Text style={s.btnText}>{t.revealCard}</Text></TouchableOpacity>:<Text style={s.muted}>{t.waiting}</Text>}</View>:null}
    {game.phase==="vote"&&<View style={s.panel}><Text style={s.h2}>{t.vote}</Text>{game.proposals.map(p=><TouchableOpacity key={p.id} onPress={()=>vote(p.authorId)} style={s.targetBtn}><Text>{game.players.find(x=>x.id===p.authorId)?.name??"?"}</Text></TouchableOpacity>)}</View>}
    {game.phase==="result"?<View style={s.panel}><Text style={s.h1}>🎭 {game.result?game.players.find(p=>p.id===game.result)?.name:"Égalité / impossible à démasquer"}</Text><TouchableOpacity style={s.btnPurple} onPress={next}><Text style={s.btnText}>{t.continue}</Text></TouchableOpacity></View>:null}
    <TouchableOpacity onPress={leave} style={s.leave}><Text>{t.leave}</Text></TouchableOpacity>
    <Modal visible={settings} transparent animationType="slide" onRequestClose={()=>setSettings(false)}><View style={s.modalShade}><View style={s.modal}><Text style={s.h1}>{t.settings}</Text>{isHost&&<><TouchableOpacity style={s.mode} onPress={()=>hostAction(g=>({...g,mode:"target",identity:"reveal",demasking:false}))}><Text>{t.target}</Text></TouchableOpacity><TouchableOpacity style={s.mode} disabled={game.players.length<3} onPress={()=>hostAction(g=>({...g,mode:"intense"}))}><Text>{t.intense}</Text></TouchableOpacity><TouchableOpacity style={s.mode} onPress={()=>hostAction(g=>({...g,order:"order"}))}><Text>{t.order}</Text></TouchableOpacity><TouchableOpacity style={s.mode} onPress={()=>hostAction(g=>({...g,order:"disorder"}))}><Text>{t.disorder}</Text></TouchableOpacity>{game.mode==="intense"&&<TouchableOpacity style={s.mode} onPress={()=>hostAction(g=>({...g,identity:g.identity==="reveal"?"hidden":"reveal",demasking:g.demasking}))}><Text>{game.identity==="reveal"?t.reveal:t.hidden}</Text></TouchableOpacity>} {game.mode==="intense"&&<TouchableOpacity style={s.mode} onPress={()=>hostAction(g=>({...g,demasking:!g.demasking}))}><Text>{t.demask}: {game.demasking?"ON":"OFF"}</Text></TouchableOpacity>}</>}<TouchableOpacity style={s.mode} onPress={()=>{setSettings(false);setRules(true)}}><Text>{t.rules}</Text></TouchableOpacity><TouchableOpacity style={s.btnPurple} onPress={()=>setSettings(false)}><Text style={s.btnText}>{t.close}</Text></TouchableOpacity></View></View></Modal>
    <Modal visible={rules} transparent animationType="fade" onRequestClose={()=>setRules(false)}><View style={s.modalShade}><View style={s.modal}><ScrollView><Text style={s.rules}>{rulesText}</Text></ScrollView><TouchableOpacity style={s.btnPurple} onPress={()=>setRules(false)}><Text style={s.btnText}>{t.close}</Text></TouchableOpacity></View></View></Modal>
  </ScrollView></SafeAreaView>;
}

