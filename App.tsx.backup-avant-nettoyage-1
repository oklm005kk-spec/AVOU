const RTL_LANGS = new Set<Lang>(["ar", "ur"]);
const TRANSLATION_TARGETS: Record<Lang, string> = { fr: "fr", en: "en", it: "it", ar: "ar", zh: "zh-CN", hi: "hi", bn: "bn", pt: "pt", ru: "ru", ur: "ur" };
let CURRENT_LANG: Lang = "fr";
let CURRENT_PLAYER_NAMES = new Set<string>();
const translationCache = new Map<string, string>();
const translationPending = new Map<string, Promise<string>>();

async function autoTranslateText(text: string, target: Lang): Promise<string> {
  const clean = text.trim();
  if (!clean || target === "fr") return text;
  const key = `${target}|${clean}`;
  const cached = translationCache.get(key);
  if (cached) return cached;
  const pending = translationPending.get(key);
  if (pending) return pending;

  const promise = (async () => {
    try {
      const q = encodeURIComponent(clean);
      const url = `https://translate.googleapis.com/translate_a/single?client=gtx&sl=auto&tl=${encodeURIComponent(TRANSLATION_TARGETS[target])}&dt=t&q=${q}`;
      const response = await fetch(url);
      if (!response.ok) return text;
      const data = await response.json();
      const translated = Array.isArray(data?.[0])
        ? data[0].map((part: unknown) => Array.isArray(part) ? String(part[0] ?? "") : "").join("")
        : text;
      const result = translated.trim() ? translated : text;
      translationCache.set(key, result);
      return result;
    } catch {
      return text;
    } finally {
      translationPending.delete(key);
    }
  })();
  translationPending.set(key, promise);
  return promise;
}

function LocalizedText({ translate = true, children, ...props }: any) {
  const raw = typeof children === "string" ? children : null;
  const [display, setDisplay] = useState(raw ?? "");
  const lang = CURRENT_LANG;

  useEffect(() => {
    let active = true;
    const knownLocalized = raw ? Object.values(TEXT[lang]).includes(raw.trim()) : false;
    if (!raw || !translate || lang === "fr" || knownLocalized || translationCache.has(`${lang}|${raw.trim()}`) || CURRENT_PLAYER_NAMES.has(raw.trim())) {
      setDisplay(raw ?? "");
      return () => { active = false; };
    }
    setDisplay(raw);
    autoTranslateText(raw, lang).then((value) => {
      if (active) setDisplay(value);
    });
    return () => { active = false; };
  }, [raw, translate, lang]);

  if (raw !== null) return <RNText {...props}>{display}</RNText>;
  return <RNText {...props}>{children}</RNText>;
}

