    if (!isMember) {
      return (
        <View style={styles.center}>
          <View style={styles.goodCard}>
            <Text style={styles.goodEmoji}>⏳</Text>
            <Text style={styles.goodTitle}>{t.waitingApproval}</Text>
            <Text style={styles.goodText}>{isPending ? game.code : t.removed}</Text>
